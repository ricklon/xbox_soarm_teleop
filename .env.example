# Keys for the twin's vision benchmark. Copy this file to .env (it is ignored
# by git) and fill in only what you use. A key set in the environment wins;
# then .env in the current folder, this project's .env, then ~/.env.
# None is needed for the oracle, molmo or ollama pointers. Never commit a key.

# Gemini Robotics-ER: soarm-twin --pointer gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vision models on OpenRouter (general Gemini, Gemma 4): --pointer openrouter[:model]
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI, for the Clef success judge (vision benchmark step 3).
# A token with Workers AI permission, and the account it belongs to.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
